  speakerName: Tendero
  lines:
  - text: "\xA1Hola! Bienvenido a la Tiendita."
    options: []
  - text: Tengo bolsas de frituras con Flipits adentro.
    options: []
  - text: "\xBFQuieres comprar una bolsa de frituras?"
    options:
    - displayText: "S\xED, deme una"
      requiredEventId: 
      targetLineIndex: 3
    - displayText: No, gracias
      requiredEventId: 
      targetLineIndex: 999
  - text: "\xA1Aqu\xED tienes! Espero que te toque un Flipit raro. \xA1Vuelve pronto!"
    options: []
